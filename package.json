{
  "name": "crmail-research-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "lint": "astro check",
    "format:check": "prettier --check src tests playwright.config.ts astro.config.mjs package.json tsconfig.json .github/workflows/pages.yml",
    "format": "prettier --write src tests playwright.config.ts astro.config.mjs package.json tsconfig.json .github/workflows/pages.yml",
    "test": "node --test src/site/*.test.mjs",
    "check:links": "node src/site/check-links.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@mantine/core": "9.7.1",
    "@mantine/hooks": "9.7.1",
    "@tanstack/react-query": "5.104.1",
    "astro": "7.3.6",
    "marked": "18.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "5.9.3"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ]
  }
}
